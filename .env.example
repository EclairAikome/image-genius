# OpenAI API Key (required for API mode image generation)
OPENAI_API_KEY=sk-...

# Anthropic API Key (optional — only needed for standalone CLI use)
# When running inside Claude Code, your subscription is used automatically.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: custom API endpoint (for proxies or alternative providers)
# OPENAI_BASE_URL=https://api.openai.com/v1
